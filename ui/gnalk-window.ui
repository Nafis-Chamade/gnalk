<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="GnalkWindow" parent="AdwApplicationWindow">
    <property name="default-width">900</property>
    <property name="default-height">600</property>
    <property name="width-request">360</property>
    <property name="height-request">294</property>
    <property name="title" translatable="yes">Gnalk</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 600sp</condition>
        <setter object="split_view" property="collapsed">true</setter>
      </object>
    </child>
    <property name="content">
      <object class="GtkStack" id="main_stack">
        <property name="transition-type">crossfade</property>
        <property name="visible-child-name">loading</property>
        <!-- Loading page (shown during startup) -->
        <child>
          <object class="GtkStackPage">
            <property name="name">loading</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-title">false</property>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkSpinner">
                        <property name="spinning">true</property>
                        <property name="width-request">32</property>
                        <property name="height-request">32</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <!-- Login page -->
        <child>
          <object class="GtkStackPage">
            <property name="name">login</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-end-title-buttons">true</property>
                    <property name="title-widget">
                      <object class="AdwWindowTitle">
                        <property name="title" translatable="yes">Gnalk</property>
                        <property name="subtitle" translatable="yes">Connect to Nextcloud Talk</property>
                      </object>
                    </property>
                  </object>
                </child>
                <property name="content">
                  <object class="GnalkLoginView" id="login_view"/>
                </property>
              </object>
            </property>
          </object>
        </child>
        <!-- Main app page -->
        <child>
          <object class="GtkStackPage">
            <property name="name">main</property>
            <property name="child">
              <object class="AdwToastOverlay" id="toast_overlay">
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GnalkNetworkStatusBar" id="network_status_bar"/>
                    </child>
                    <child>
                      <object class="AdwNavigationSplitView" id="split_view">
                        <property name="vexpand">true</property>
        <property name="min-sidebar-width">280</property>
        <property name="max-sidebar-width">400</property>
        <property name="sidebar">
          <object class="AdwNavigationPage">
            <property name="title" translatable="yes">Conversations</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-title">false</property>
                    <child type="start">
                      <object class="GnalkUserStatusMenu" id="user_status_menu"/>
                    </child>
                    <child type="start">
                      <object class="GnalkAccountSwitcher" id="account_switcher">
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkMenuButton">
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="menu-model">primary_menu</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkSpinner" id="connecting_spinner">
                        <property name="spinning">false</property>
                        <property name="visible">false</property>
                        <property name="tooltip-text" translatable="yes">Connecting...</property>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="GnalkConversationSidebar" id="conversation_sidebar"/>
                </property>
              </object>
            </property>
          </object>
        </property>
        <property name="content">
          <object class="AdwNavigationPage" id="content_page">
            <property name="title" translatable="yes">Messages</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar" id="content_header">
                    <property name="show-title">false</property>
                    <child type="start">
                      <object class="GnalkConversationHeader" id="conversation_header">
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkButton" id="video_call_button">
                        <property name="icon-name">camera-web-symbolic</property>
                        <property name="sensitive">false</property>
                        <property name="tooltip-text" translatable="yes">Start Video Call</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkButton" id="audio_call_button">
                        <property name="icon-name">call-start-symbolic</property>
                        <property name="sensitive">false</property>
                        <property name="tooltip-text" translatable="yes">Start Audio Call</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkToggleButton" id="participants_toggle_button">
                        <property name="icon-name">system-users-symbolic</property>
                        <property name="active">true</property>
                        <property name="tooltip-text" translatable="yes">Show/Hide Participants</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GnalkIncomingCallBanner" id="incoming_call_banner"/>
                    </child>
                    <child>
                      <object class="GnalkParticipantsList" id="participants_list"/>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GnalkMessageView" id="message_view">
                            <property name="vexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GnalkTypingIndicator" id="typing_indicator"/>
                        </child>
                        <child>
                          <object class="GnalkConversationActions" id="conversation_actions"/>
                        </child>
                        <child>
                          <object class="GnalkMessageInput" id="message_input"/>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Preferences</attribute>
        <attribute name="action">win.preferences</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">About Gnalk</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
