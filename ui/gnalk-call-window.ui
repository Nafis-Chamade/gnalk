<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="GnalkCallWindow" parent="AdwWindow">
    <property name="title" translatable="yes">Call</property>
    <property name="default-width">640</property>
    <property name="default-height">800</property>
    <property name="width-request">320</property>
    <property name="height-request">480</property>
    <!-- Show header bar on non-mobile (width >= 500px) -->
    <child>
      <object class="AdwBreakpoint">
        <condition>min-width: 500sp</condition>
        <setter object="toolbar_view" property="reveal-top-bars">true</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwToolbarView" id="toolbar_view">
        <property name="reveal-top-bars">false</property>
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <binding name="title">
                  <lookup name="room-name" type="GnalkCallWindow">
                    <lookup name="root">GnalkCallWindow</lookup>
                  </lookup>
                </binding>
                <binding name="subtitle">
                  <lookup name="call-status" type="GnalkCallWindow">
                    <lookup name="root">GnalkCallWindow</lookup>
                  </lookup>
                </binding>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="GtkOverlay" id="video_overlay">
            <!-- Main content: stack switching between local preview and call layout -->
            <child>
              <object class="GtkStack" id="video_stack">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">200</property>
                <!-- Local preview fullscreen (shown before stream starts) -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">preview</property>
                    <property name="child">
                      <object class="GtkPicture" id="local_video_fullscreen">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <property name="content-fit">cover</property>
                        <style>
                          <class name="call-video"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </child>
                <!-- Connecting state (spinner shown during WebRTC setup) -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">connecting</property>
                    <property name="child">
                      <object class="GtkBox" id="connecting_box">
                        <property name="orientation">vertical</property>
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <property name="halign">fill</property>
                        <property name="valign">fill</property>
                        <style>
                          <class name="call-connecting"/>
                        </style>
                        <child>
                          <object class="GtkSpinner" id="connecting_spinner">
                            <property name="spinning">true</property>
                            <property name="halign">center</property>
                            <property name="valign">end</property>
                            <property name="vexpand">true</property>
                            <property name="width-request">48</property>
                            <property name="height-request">48</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="connecting_label">
                            <property name="label" translatable="yes">Connecting...</property>
                            <property name="halign">center</property>
                            <property name="valign">start</property>
                            <property name="vexpand">true</property>
                            <property name="margin-top">12</property>
                            <style>
                              <class name="title-2"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <!-- Multi-participant call view -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">call</property>
                    <property name="child">
                      <object class="GtkStack" id="layout_stack">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <property name="transition-type">crossfade</property>
                        <property name="transition-duration">150</property>
                        <!-- Grid layout mode -->
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">grid</property>
                            <property name="child">
                              <object class="GtkGrid" id="video_grid">
                                <property name="hexpand">true</property>
                                <property name="vexpand">true</property>
                                <property name="row-homogeneous">true</property>
                                <property name="column-homogeneous">true</property>
                                <property name="row-spacing">4</property>
                                <property name="column-spacing">4</property>
                                <style>
                                  <class name="video-grid"/>
                                </style>
                              </object>
                            </property>
                          </object>
                        </child>
                        <!-- Speaker focus layout mode -->
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">speaker</property>
                            <property name="child">
                              <object class="GtkBox" id="speaker_view">
                                <property name="orientation">vertical</property>
                                <property name="hexpand">true</property>
                                <property name="vexpand">true</property>
                                <property name="spacing">4</property>
                                <style>
                                  <class name="speaker-view"/>
                                </style>
                                <!-- Large area for active speaker -->
                                <child>
                                  <object class="GtkBox" id="speaker_main">
                                    <property name="orientation">vertical</property>
                                    <property name="hexpand">true</property>
                                    <property name="vexpand">true</property>
                                    <style>
                                      <class name="speaker-main"/>
                                    </style>
                                  </object>
                                </child>
                                <!-- Strip for other participants -->
                                <child>
                                  <object class="GtkScrolledWindow">
                                    <property name="hscrollbar-policy">automatic</property>
                                    <property name="vscrollbar-policy">never</property>
                                    <property name="hexpand">true</property>
                                    <property name="height-request">120</property>
                                    <child>
                                      <object class="GtkBox" id="speaker_strip">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">4</property>
                                        <style>
                                          <class name="speaker-strip"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <!-- Local preview overlay (small, top-left, shown during call) -->
            <child type="overlay">
              <object class="GtkScrolledWindow" id="local_video_box">
                <property name="visible">false</property>
                <property name="halign">start</property>
                <property name="valign">start</property>
                <property name="hexpand">false</property>
                <property name="vexpand">false</property>
                <property name="margin-top">12</property>
                <property name="margin-start">12</property>
                <property name="width-request">160</property>
                <property name="height-request">120</property>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">never</property>
                <property name="propagate-natural-width">false</property>
                <property name="propagate-natural-height">false</property>
                <style>
                  <class name="local-preview-frame"/>
                </style>
                <child>
                  <object class="GtkPicture" id="local_video_frame">
                    <property name="can-shrink">true</property>
                    <property name="content-fit">cover</property>
                    <style>
                      <class name="call-video-overlay"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <!-- Call controls -->
            <child type="overlay">
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="halign">center</property>
                <property name="valign">end</property>
                <property name="spacing">12</property>
                <property name="margin-bottom">12</property>
                <style>
                  <class name="call-controls"/>
                </style>
                <child>
                  <object class="GtkButton" id="layout_toggle_button">
                    <property name="icon-name">view-grid-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Toggle Layout</property>
                    <style>
                      <class name="circular"/>
                      <class name="osd"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="switch_camera_button">
                    <property name="icon-name">camera-switch-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Switch Camera</property>
                    <style>
                      <class name="circular"/>
                      <class name="osd"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="mute_audio_button">
                    <property name="icon-name">microphone-sensitivity-high-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Mute Audio</property>
                    <style>
                      <class name="circular"/>
                      <class name="osd"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="mute_video_button">
                    <property name="icon-name">camera-photo-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Disable Video</property>
                    <style>
                      <class name="circular"/>
                      <class name="osd"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="screen_share_button">
                    <property name="icon-name">preferences-desktop-display-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Share Screen</property>
                    <style>
                      <class name="circular"/>
                      <class name="osd"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="raise_hand_button">
                    <property name="icon-name">palm-up-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Raise Hand</property>
                    <style>
                      <class name="circular"/>
                      <class name="osd"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="reaction_button">
                    <property name="icon-name">face-smile-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Reactions</property>
                    <style>
                      <class name="circular"/>
                      <class name="osd"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="hangup_button">
                    <property name="icon-name">call-stop-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Hang Up</property>
                    <style>
                      <class name="circular"/>
                      <class name="destructive-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
