<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="GnalkConversationInfoDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Conversation Info</property>
    <property name="content-width">400</property>
    <property name="content-height">500</property>
    <property name="child">
      <object class="AdwNavigationView" id="navigation_view">
        <!-- Info Page (default) -->
        <child>
          <object class="AdwNavigationPage" id="info_page">
            <property name="tag">info</property>
            <property name="title" translatable="yes">Info</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-end-title-buttons">true</property>
                    <child type="end">
                      <object class="GtkButton" id="settings_button">
                        <property name="icon-name">emblem-system-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Settings</property>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">350</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">18</property>
                            <!-- Avatar and name section -->
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="halign">center</property>
                                <property name="spacing">12</property>
                                <child>
                                  <object class="GtkFrame">
                                    <property name="overflow">hidden</property>
                                    <property name="halign">center</property>
                                    <style>
                                      <class name="avatar-frame-large"/>
                                    </style>
                                    <child>
                                      <object class="GtkImage" id="info_avatar">
                                        <property name="pixel-size">96</property>
                                        <property name="icon-name">avatar-default-symbolic</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="info_name">
                                    <property name="wrap">true</property>
                                    <property name="max-width-chars">30</property>
                                    <property name="justify">center</property>
                                    <style>
                                      <class name="title-1"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="info_description">
                                    <property name="wrap">true</property>
                                    <property name="max-width-chars">40</property>
                                    <property name="justify">center</property>
                                    <property name="visible">false</property>
                                    <property name="selectable">true</property>
                                    <property name="focusable">false</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <!-- Participants Section -->
                            <child>
                              <object class="AdwPreferencesGroup" id="participants_group">
                                <property name="title" translatable="yes">Participants</property>
                                <child>
                                  <object class="GtkListBox" id="participants_listbox">
                                    <property name="selection-mode">none</property>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinner" id="participants_spinner">
                                    <property name="halign">center</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <!-- Shared Media Section -->
                            <child>
                              <object class="AdwPreferencesGroup" id="media_group">
                                <property name="title" translatable="yes">Shared Media</property>
                                <child>
                                  <object class="GtkFlowBox" id="media_flowbox">
                                    <property name="min-children-per-line">3</property>
                                    <property name="max-children-per-line">4</property>
                                    <property name="column-spacing">6</property>
                                    <property name="row-spacing">6</property>
                                    <property name="selection-mode">none</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="media_empty_label">
                                    <property name="label" translatable="yes">No shared media</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <!-- Settings Page -->
        <child>
          <object class="AdwNavigationPage" id="settings_page">
            <property name="tag">settings</property>
            <property name="title" translatable="yes">Settings</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-end-title-buttons">false</property>
                    <child type="end">
                      <object class="GtkButton" id="save_button">
                        <property name="label" translatable="yes">Save</property>
                        <style>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <child>
                      <object class="AdwClamp">
                        <property name="maximum-size">350</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">18</property>
                            <!-- Conversation settings (for group rooms with moderator) -->
                            <child>
                              <object class="AdwPreferencesGroup" id="conversation_settings_group">
                                <property name="title" translatable="yes">Conversation</property>
                                <property name="visible">false</property>
                                <child>
                                  <object class="AdwEntryRow" id="settings_name_entry">
                                    <property name="title" translatable="yes">Name</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwEntryRow" id="settings_description_entry">
                                    <property name="title" translatable="yes">Description</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="settings_avatar_row">
                                    <property name="title" translatable="yes">Avatar</property>
                                    <child type="prefix">
                                      <object class="GtkFrame">
                                        <property name="overflow">hidden</property>
                                        <style>
                                          <class name="avatar-frame-small"/>
                                        </style>
                                        <child>
                                          <object class="GtkImage" id="settings_avatar_preview">
                                            <property name="pixel-size">48</property>
                                            <property name="icon-name">avatar-default-symbolic</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child type="suffix">
                                      <object class="GtkButton" id="change_avatar_button">
                                        <property name="label" translatable="yes">Change</property>
                                        <property name="valign">center</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <!-- Notification settings (for all conversation types) -->
                            <child>
                              <object class="AdwPreferencesGroup">
                                <property name="title" translatable="yes">Notifications</property>
                                <child>
                                  <object class="AdwComboRow" id="notification_level_row">
                                    <property name="title" translatable="yes">Messages</property>
                                    <property name="model">
                                      <object class="GtkStringList">
                                        <items>
                                          <item translatable="yes">All messages</item>
                                          <item translatable="yes">Mentions only</item>
                                          <item translatable="yes">Off</item>
                                        </items>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSwitchRow" id="call_notifications_row">
                                    <property name="title" translatable="yes">Call notifications</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <!-- Spinner for saving -->
                            <child>
                              <object class="GtkSpinner" id="settings_spinner">
                                <property name="halign">center</property>
                                <property name="spinning">false</property>
                                <property name="visible">false</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
