<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <menu id="media_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Attach File</attribute>
        <attribute name="action">msg-input.media-action</attribute>
        <attribute name="target" type="i">0</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Record Voice</attribute>
        <attribute name="action">msg-input.media-action</attribute>
        <attribute name="target" type="i">1</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Take Photo/Video</attribute>
        <attribute name="action">msg-input.media-action</attribute>
        <attribute name="target" type="i">2</attribute>
      </item>
    </section>
  </menu>
  <template class="GnalkMessageInput" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="spacing">8</property>
    <style>
      <class name="message-entry-box"/>
    </style>
    <child>
      <object class="AdwSplitButton" id="media_button">
        <property name="icon-name">mail-attachment-symbolic</property>
        <property name="tooltip-text" translatable="yes">Attach File</property>
        <property name="menu-model">media_menu</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuButton" id="emoji_button">
        <property name="icon-name">face-smile-symbolic</property>
        <property name="tooltip-text" translatable="yes">Insert Emoji</property>
        <property name="popover">
          <object class="GtkEmojiChooser" id="emoji_chooser"/>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkOverlay" id="text_overlay">
        <property name="hexpand">true</property>
        <child type="overlay">
          <object class="GtkLabel" id="placeholder_label">
            <property name="label" translatable="yes">Type a message...</property>
            <property name="halign">start</property>
            <property name="valign">start</property>
            <property name="margin-start">9</property>
            <property name="margin-top">5</property>
            <style><class name="message-placeholder"/></style>
          </object>
        </child>
        <property name="child">
          <object class="GtkScrolledWindow" id="scroll">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">external</property>
            <style><class name="message-text-scroll"/></style>
            <property name="child">
              <object class="GtkTextView" id="message_entry">
                <property name="wrap-mode">word-char</property>
                <property name="accepts-tab">false</property>
                <property name="hexpand">true</property>
                <property name="top-margin">4</property>
                <property name="bottom-margin">4</property>
                <property name="left-margin">8</property>
                <property name="right-margin">8</property>
                <style><class name="message-text-view"/></style>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="send_button">
        <property name="icon-name">mail-send-symbolic</property>
        <property name="tooltip-text" translatable="yes">Send</property>
        <style>
          <class name="suggested-action"/>
        </style>
      </object>
    </child>
  </template>
</interface>
