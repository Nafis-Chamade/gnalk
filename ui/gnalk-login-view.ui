<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="GnalkLoginView" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="vexpand">true</property>
    <child>
      <object class="AdwClamp">
        <property name="maximum-size">400</property>
        <property name="margin-top">24</property>
        <property name="margin-bottom">24</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="valign">center</property>
        <property name="vexpand">true</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">24</property>
            <!-- Header with icon and description -->
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <property name="halign">center</property>
                <child>
                  <object class="GtkImage" id="header_icon">
                    <property name="icon-name">network-server-symbolic</property>
                    <property name="pixel-size">64</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="header_label">
                    <property name="label" translatable="yes">Sign in to your Nextcloud Talk server</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <!-- Mode selector (segmented buttons) -->
            <child>
              <object class="GtkBox" id="mode_selector_box">
                <property name="orientation">horizontal</property>
                <property name="halign">center</property>
                <property name="spacing">0</property>
                <style>
                  <class name="linked"/>
                </style>
                <child>
                  <object class="GtkToggleButton" id="account_mode_button">
                    <property name="label" translatable="yes">Account</property>
                    <property name="active">true</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton" id="guest_mode_button">
                    <property name="label" translatable="yes">Guest</property>
                    <property name="active">false</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <!-- GOA accounts section -->
            <child>
              <object class="AdwPreferencesGroup" id="goa_accounts_group">
                <property name="visible">false</property>
                <property name="title" translatable="yes">GNOME Online Accounts</property>
                <property name="description" translatable="yes">Select a configured Nextcloud account</property>
                <!-- GOA account rows are added dynamically -->
              </object>
            </child>
            <!-- Link to show manual login when GOA is shown -->
            <child>
              <object class="GtkButton" id="manual_login_link">
                <property name="visible">false</property>
                <property name="label" translatable="yes">Or sign in with different credentials</property>
                <property name="halign">center</property>
                <property name="margin-bottom">12</property>
                <style>
                  <class name="flat"/>
                  <class name="link"/>
                </style>
              </object>
            </child>
            <!-- User mode fields -->
            <child>
              <object class="AdwPreferencesGroup" id="user_mode_group">
                <child>
                  <object class="AdwEntryRow" id="server_entry">
                    <property name="title" translatable="yes">Server URL</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="user_entry">
                    <property name="title" translatable="yes">User ID</property>
                  </object>
                </child>
                <child>
                  <object class="AdwPasswordEntryRow" id="password_entry">
                    <property name="title" translatable="yes">Password</property>
                  </object>
                </child>
              </object>
            </child>
            <!-- Guest mode fields -->
            <child>
              <object class="AdwPreferencesGroup" id="guest_mode_group">
                <property name="visible">false</property>
                <child>
                  <object class="AdwEntryRow" id="room_url_entry">
                    <property name="title" translatable="yes">Room URL</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="display_name_entry">
                    <property name="title" translatable="yes">Display Name</property>
                  </object>
                </child>
                <child>
                  <object class="AdwPasswordEntryRow" id="guest_password_entry">
                    <property name="title" translatable="yes">Room Password (optional)</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="button_box">
                <property name="orientation">horizontal</property>
                <property name="halign">center</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkButton" id="cancel_button">
                    <property name="label" translatable="yes">Cancel</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="connect_button">
                    <property name="label" translatable="yes">Connect</property>
                    <style>
                      <class name="suggested-action"/>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSpinner" id="spinner">
                <property name="halign">center</property>
                <property name="spinning">false</property>
                <property name="visible">false</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="status_label">
                <property name="halign">center</property>
                <property name="wrap">true</property>
                <property name="visible">false</property>
                <style>
                  <class name="error"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
