<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="GnalkConversationRow" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="spacing">12</property>
    <style>
      <class name="conversation-row"/>
    </style>
    <child>
      <object class="GtkOverlay">
        <child>
          <object class="GtkFrame">
            <property name="overflow">hidden</property>
            <style>
              <class name="conversation-avatar"/>
            </style>
            <child>
              <object class="GtkImage" id="avatar">
                <property name="pixel-size">48</property>
                <property name="icon-name">avatar-default-symbolic</property>
              </object>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkImage" id="status_icon">
            <property name="pixel-size">14</property>
            <property name="halign">end</property>
            <property name="valign">end</property>
            <property name="visible">false</property>
            <style>
              <class name="status-indicator"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="valign">center</property>
        <property name="hexpand">true</property>
        <property name="spacing">4</property>
        <child>
          <object class="GtkLabel" id="title_label">
            <property name="halign">start</property>
            <property name="ellipsize">end</property>
            <style>
              <class name="conversation-title"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkImage" id="sent_status_icon">
                <property name="pixel-size">12</property>
                <property name="icon-name">emblem-ok-symbolic</property>
                <property name="visible">false</property>
                <property name="valign">center</property>
                <style>
                  <class name="sent-status-icon"/>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="subtitle_label">
                <property name="halign">start</property>
                <property name="hexpand">true</property>
                <property name="ellipsize">end</property>
                <property name="lines">1</property>
                <style>
                  <class name="conversation-subtitle"/>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="unread_badge">
        <property name="halign">end</property>
        <property name="valign">center</property>
        <property name="visible">false</property>
        <style>
          <class name="unread-badge"/>
        </style>
      </object>
    </child>
  </template>
</interface>
