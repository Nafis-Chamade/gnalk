#: data/net.skilpa.gnalk.desktop.in:3 data/net.skilpa.gnalk.metainfo.xml.in:6
#: ui/gnalk-window.ui:10 ui/gnalk-window.ui:61
msgid "Gnalk"
msgstr "Gnalk"

#: data/net.skilpa.gnalk.desktop.in:4 data/net.skilpa.gnalk.metainfo.xml.in:7
msgid "Nextcloud Talk Client"
msgstr "Client Nextcloud Talk"

#: data/net.skilpa.gnalk.desktop.in:10
msgid "nextcloud;talk;chat;messenger;"
msgstr "nextcloud;discussion;tchat;messagerie;conversation;"

#: data/net.skilpa.gnalk.metainfo.xml.in:9
msgid ""
"Gnalk is a native GTK4 client for Nextcloud Talk, allowing you to chat and "
"make audio/video calls with your Nextcloud contacts."
msgstr ""
"Gnalk est un client GTK4 natif pour Nextcloud Talk, vous permettant de "
"discuter et de passer des appels audio/vidéo avec vos contacts Nextcloud."

#: data/net.skilpa.gnalk.metainfo.xml.in:13
msgid "Features:"
msgstr "Fonctionnalités :"

#: data/net.skilpa.gnalk.metainfo.xml.in:15
msgid "View and search conversations"
msgstr "Afficher et rechercher des conversations"

#: data/net.skilpa.gnalk.metainfo.xml.in:16
msgid "Send and receive messages"
msgstr "Envoyer et recevoir des messages"

#: data/net.skilpa.gnalk.metainfo.xml.in:17
msgid "Audio and video calls"
msgstr "Appels audio et vidéo"

#: data/net.skilpa.gnalk.metainfo.xml.in:18
msgid "Adaptive layout for desktop and mobile"
msgstr "Interface adaptative pour ordinateur et mobile"

#: data/net.skilpa.gnalk.metainfo.xml.in:23
msgid "Main window showing conversations"
msgstr "Fenêtre principale affichant les conversations"

#: data/net.skilpa.gnalk.metainfo.xml.in:33
msgid "Initial release"
msgstr "Version initiale"

#: data/net.skilpa.gnalk.metainfo.xml.in:46
msgid "Skilpa"
msgstr "Skilpa"

#: data/net.skilpa.gnalk.gschema.xml:6
msgid "Window width"
msgstr "Largeur de la fenêtre"

#: data/net.skilpa.gnalk.gschema.xml:7
msgid "The width of the main window"
msgstr "La largeur de la fenêtre principale"

#: data/net.skilpa.gnalk.gschema.xml:11
msgid "Window height"
msgstr "Hauteur de la fenêtre"

#: data/net.skilpa.gnalk.gschema.xml:12
msgid "The height of the main window"
msgstr "La hauteur de la fenêtre principale"

#: data/net.skilpa.gnalk.gschema.xml:16
msgid "Window maximized"
msgstr "Fenêtre maximisée"

#: data/net.skilpa.gnalk.gschema.xml:17
msgid "Whether the window is maximized"
msgstr "Indique si la fenêtre est maximisée"

#: data/net.skilpa.gnalk.gschema.xml:21
msgid "Last server URL"
msgstr "Dernière URL du serveur"

#: data/net.skilpa.gnalk.gschema.xml:22
msgid "The URL of the last connected Nextcloud server"
msgstr "L'URL du dernier serveur Nextcloud utilisé"

#: data/net.skilpa.gnalk.gschema.xml:26
msgid "Last user ID"
msgstr "Dernier identifiant utilisateur"

#: data/net.skilpa.gnalk.gschema.xml:27
msgid "The user ID used for the last connection"
msgstr "L'identifiant utilisateur de la dernière connexion"

#: data/net.skilpa.gnalk.gschema.xml:31
msgid "Last display name"
msgstr "Dernier nom d'affichage"

#: data/net.skilpa.gnalk.gschema.xml:32
msgid "The display name of the last logged in user"
msgstr "Le nom d'affichage du dernier utilisateur connecté"

#: data/net.skilpa.gnalk.gschema.xml:36
msgid "Auto-login enabled"
msgstr "Connexion automatique activée"

#: data/net.skilpa.gnalk.gschema.xml:37
msgid "Whether to automatically log in on startup using saved credentials"
msgstr ""
"Se connecter automatiquement au démarrage avec les identifiants enregistrés"

#: data/net.skilpa.gnalk.gschema.xml:41
msgid "Last opened room"
msgstr "Dernier salon ouvert"

#: data/net.skilpa.gnalk.gschema.xml:42
msgid "The token of the last opened conversation room"
msgstr "Le jeton du dernier salon de conversation ouvert"

#: data/net.skilpa.gnalk.gschema.xml:46
msgid "Last active account"
msgstr "Dernier compte actif"

#: data/net.skilpa.gnalk.gschema.xml:47
msgid "The ID of the last active account for multi-account support"
msgstr "L'identifiant du dernier compte actif pour la gestion multi-comptes"

#: data/net.skilpa.gnalk.gschema.xml:51
msgid "Preferred video device"
msgstr "Périphérique vidéo préféré"

#: data/net.skilpa.gnalk.gschema.xml:52
msgid "The device path or name of the preferred camera"
msgstr "Le chemin ou le nom du périphérique de la caméra préférée"

#: data/net.skilpa.gnalk.gschema.xml:56
msgid "Preferred audio device"
msgstr "Périphérique audio préféré"

#: data/net.skilpa.gnalk.gschema.xml:57
msgid "The device path or name of the preferred microphone"
msgstr "Le chemin ou le nom du périphérique du microphone préféré"

#: data/net.skilpa.gnalk.gschema.xml:61
msgid "Camera quality"
msgstr "Qualité de la caméra"

#: data/net.skilpa.gnalk.gschema.xml:62
msgid "Camera quality preset: 0=Low (fast), 1=Medium, 2=High (best FOV)"
msgstr ""
"Préréglage de qualité : 0=Basse (rapide), 1=Moyenne, 2=Haute (meilleur champ "
"de vision)"

#: data/net.skilpa.gnalk.gschema.xml:66
msgid "Camera position"
msgstr "Position de la caméra"

#: data/net.skilpa.gnalk.gschema.xml:67
msgid "Default camera position: 0=Front, 1=Back, 2=Generic"
msgstr "Position par défaut de la caméra : 0=Avant, 1=Arrière, 2=Générique"

#: data/net.skilpa.gnalk.gschema.xml:71
msgid "Color scheme"
msgstr "Thème de couleurs"

#: data/net.skilpa.gnalk.gschema.xml:72
msgid "Application color scheme: 0=Auto (follow system), 1=Light, 2=Dark"
msgstr "Thème de couleurs : 0=Auto (suivre le système), 1=Clair, 2=Sombre"

#: data/net.skilpa.gnalk.gschema.xml:76
msgid "Conversation background style"
msgstr "Style d'arrière-plan de la conversation"

#: data/net.skilpa.gnalk.gschema.xml:77
msgid ""
"Background pattern for the message list: 0=Flat, 1=Grid, 2=Hexagons, "
"3=Isometric, 4=Rhombus, 5=ZigZag, 6=Houndstooth, 7=Herringbone, 8=Stars, "
"9=Triangles, 10=Waves, 11=Scales, 12=Cross, 13=Mosaic (participant avatars)"
msgstr ""
"Motif d'arrière-plan de la liste de messages : 0=Uni, 1=Grille, 2=Hexagones, "
"3=Isométrique, 4=Losanges, 5=ZigZag, 6=Pied-de-poule, 7=Chevrons, 8=Étoiles, "
"9=Triangles, 10=Vagues, 11=Écailles, 12=Croix, 13=Mosaïque (avatars des "
"participants)"

#: data/net.skilpa.gnalk.gschema.xml:81
msgid "Show participants list"
msgstr "Afficher la liste des participants"

#: data/net.skilpa.gnalk.gschema.xml:82
msgid "Whether to show the participants list in group conversations"
msgstr "Afficher la liste des participants dans les conversations de groupe"

#: data/net.skilpa.gnalk.gschema.xml:86
msgid "Default media action"
msgstr "Action média par défaut"

#: data/net.skilpa.gnalk.gschema.xml:87
msgid ""
"Default action for the media button: 0=Attach file, 1=Record voice, 2=Take "
"photo/video"
msgstr ""
"Action par défaut du bouton média : 0=Joindre un fichier, 1=Enregistrer un "
"message vocal, 2=Prendre une photo/vidéo"

#: data/net.skilpa.gnalk.gschema.xml:91
msgid "Maximum rooms to keep loaded"
msgstr "Nombre maximal de salons chargés"

#: data/net.skilpa.gnalk.gschema.xml:92
msgid ""
"Maximum number of rooms to keep loaded in memory with their messages. Older "
"rooms are evicted when this limit is exceeded."
msgstr ""
"Nombre maximal de salons à garder en mémoire avec leurs messages. Les salons "
"les plus anciens sont déchargés lorsque cette limite est dépassée."

#: data/net.skilpa.gnalk.gschema.xml:96
msgid "Background tab message retention"
msgstr "Rétention des messages en arrière-plan"

#: data/net.skilpa.gnalk.gschema.xml:97
msgid ""
"How many viewports worth of messages to keep in backgrounded room tabs. "
"Higher values keep more messages but use more memory."
msgstr ""
"Nombre d'écrans de messages à conserver dans les onglets de salons en "
"arrière-plan. Des valeurs plus élevées conservent plus de messages mais "
"utilisent plus de mémoire."

